DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/memora
APP_ENV=development
JWT_SECRET_KEY=GENERATE_A_LOCAL_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
DOCUMENT_STORAGE_DIR=storage/documents
DOCUMENT_MAX_UPLOAD_SIZE_MB=10
DOCUMENT_MAX_EXTRACTED_TEXT_CHARS=1000000
DOCUMENT_CHUNK_SIZE_CHARS=2000
DOCUMENT_CHUNK_OVERLAP_CHARS=400
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
SEARCH_MINIMUM_SIMILARITY=0.0
